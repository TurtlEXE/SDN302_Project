# ==============================================================================
# Sport Booking Platform - Server Environment Configuration Template
# Phase P00 - Chốt cấu hình nền tảng
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Configuration
# IMPORTANT: MongoDB MUST run with Replica Set enabled to support multi-document ACID transactions
# Default port 27018 is used by `npm run db:ensure-rs` for isolated user-space replica set (rs0)
MONGODB_URI=mongodb://127.0.0.1:27018/sport_booking?replicaSet=rs0
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/sport_booking_test?replicaSet=rs0

# Authentication & JWT Configuration
# JWT Access Token is kept only in RAM on the client side (10 minutes lifetime)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long_change_in_prod
JWT_ACCESS_EXPIRES_IN=10m
JWT_ISSUER=sport-booking
JWT_AUDIENCE=sport-booking-client

# Refresh Token & Session Management
# Refresh token is stored in database as SHA-256 hash and delivered via HttpOnly Cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
SESSION_MAX_AGE_DAYS=7

# VNPay Payment Gateway Sandbox Configuration
# Documentation: https://sandbox.vnpayment.vn/apis/docs/huong-dan-tich-hop/
VNPAY_TMN_CODE=SANDBOX_TMN_CODE
VNPAY_HASH_SECRET=SANDBOX_HASH_SECRET_KEY
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result
VNPAY_IPN_URL=https://your-public-staging-domain.ngrok-free.app/api/v1/payments/vnpay-ipn

# Email Service Configuration (SMTP for development/testing, e.g. Mailtrap or Ethereal)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=SportBooking Platform <no-reply@sportbooking.local>

# Storage Configuration for Facility Images
# Supported drivers: local
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=5
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Logging & Security
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
